
model User {
  name        String
  surname     String
  info        UserInfo
  posts       Post[]        @derived(Post.author)
  projects    Project[]     @derived(Project.users.user)
}

struct UserInfo {
  bio         String
}

model Post {
  title       String
  createdAt   DateTime
  author      User
  images      File[]
}

model Project {
  name        String
  users       UserRole[]
}

struct UserRole {
  user        User          @id
  role        String
}

model File {
  name        String
}
