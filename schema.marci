model User {
  name        String
  surname     String
  email       String        @index @unique
  age         Int
  info        UserInfo
  posts       Post[]        @derived(Post.author)
  projects    Project[]     @derived(Project.users.user) @inject(Project.users { role as user_role, sign as admin_sign })
}

struct UserInfo {
  bio         String
}

model TestUser {
  name        String
  projects    TestProject[]     @derived(TestProject.users)
}

model TestProject {
  name        String
  users       TestUser[]
}

model Post {
  title       String
  createdAt   DateTime
  author      User          @onDelete(SetNull)
  images      File[]
}

model Project {
  name        String
  users       UserRole[]
}

enum Role {
  creator
  admin {
    sign      String
  }
}

struct UserRole {
  user        User          @id   @onDelete(Cascade)
  role        Role
}

model File {
  name        String
}

model LandmarkTag {
  name          String
}

model Landmark {
  name          String
  description   String
  location      Float[2]      @vectorindex
  embeddings    Float[2560]   @vectorindex(Cosine)
  tags          LandmarkTag[]
}