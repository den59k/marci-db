model Place {
    name		String
    description		String
    address		String?
    type		PlaceType
    tags		PlaceCategoryTag[]
    photoIds		File[]			@default([])
    simillarPlaces	Place[]			@default([])
}	

model Favourite {
    userId	AppUser			@onDelete(CASCADE)
    object	FavouriteObject
    createdAt	DateTime		@default(now())
}

model AppUser {
    name		String
    authentication	AuthenticationInfo
    favourites		Favourite[]		@bind(Favourite.userId)
}

model Landmark {
    name		String
    description		String
    location		String
    audioFileId		File?		@unique
    photoIds		File[]		@default([])
    indexOnLine		Int		@index
    groupId		LandmarkGroup?
    simillarLandmarks	Landmark[]	@default([])
}

model LandmarkGroup {
    name	String
    description	String
    photoIds	File[]		@default([])
    landmarks	Landmark[]	@bind(Landmark.groupId)
}

model AppTour {
    title	String
    text	String
    start	DateTime	@index
    end		DateTime
    events	Events[]
}

model File {
    name	String?
    fileSize	Int
    src		String
}

struct Events {
    order	Int
    info	EventsInfo
}

enum EventsInfo {
    visit_place
    eating
    visit_landmark {
	landmarkId	Landmark
    }
    visit_place | eating {
        placeId		Place
    }
    visit_place | visit_landmark | eating {
	time		DateTime
    }
}

enum AuthenticationInfo {
    email {
        emailVerified		Bool
    }
    vkId
    appleId
    yandexId
    vkId | yandexId {
        accessToken		String
    }
    email | vkId | appleId | yandexId {
        address			String		@unique
    }
}


enum FavouriteObject {
    place {
        placeId		Place
    }
    landmark {
	landmarkId	Landmark
    }
}

enum PlaceType {
    food {
        averageBill  		Int
        deliveryAvailable 	Bool
    }
    museum {
        price        		Int
    }
    square {
        hasParking   		Bool
    }
    park {
        isPayEntrance 		Bool
        hasWifi      		Bool
    }
    hotel {
        starRating   		Int
        pricePerNight 		Int
    }
    museum | square {
	childZone		Bool
    }
    food | museum {
	openingHours		String
    }
}

enum PlaceCategoryTag {
    culture
    fast
    walk
    art
}
