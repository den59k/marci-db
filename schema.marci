
model User {
  name        String
  surname     String
  info        UserInfo
  posts       Post[]        @derived(Post.author)
  projects    Project[]     @derived(Project.users.user) @inject(Project.users { role as user_role, sign as admin_sign })
}

struct UserInfo {
  bio         String
}

model Post {
  title       String
  createdAt   DateTime
  author      User
  images      File[]
}

model Project {
  name        String
  users       UserRole[]
}

enum Role {
  creator
  admin {
    sign      String
  }
}

struct UserRole {
  user        User          @id
  role        Role
}

model File {
  name        String
}
