{
  "name": "marcidb-embedded",
  "type": "module",
  "version": "0.12.0",
  "license": "MIT",
  "description": "Embedded (in-process) MarciDB for Bun and Node via FFI — for fast, ephemeral integration tests.",
  "author": {
    "name": "den59k"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/den59k/marci-db.git",
    "directory": "packages/marcidb-embedded"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bunup src/index.ts --external koffi --external bun:ffi --out-dir dist",
    "build:lib": "bash build-lib.sh win",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "bench": "bun test/binary-bench.ts"
  },
  "files": [
    "dist/",
    "native/"
  ],
  "dependencies": {
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bunup": "^0.16.31"
  },
  "peerDependencies": {
    "marcidb-client": "^0.12.0"
  },
  "peerDependenciesMeta": {
    "marcidb-client": {
      "optional": true
    }
  }
}
