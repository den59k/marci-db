{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],

    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,

    // Catch a missing return type on an exported declaration here (local `tsc`) rather than as a failed
    // bunup .d.ts emit during the CI npm publish.
    "isolatedDeclarations": true,

    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
