{
  "name": "marcidb-client",
  "type": "module",
  "version": "0.0.5-a",
  "license": "MIT",
  "author": {
    "name": "den59k"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/den59k/marci-db.git"
  },
  "scripts": {
    "build": "bunup src/index.ts --external .marcidb/client --out-dir runtime"
  },
  "bin": {
    "marcidb": "bin.js"
  },
  "files": [
    "bin/",
    "client/",
    "runtime/",
    "bin.js"
  ],
  "devDependencies": {
    "bunup": "^0.16.31"
  },
  "exports": {
    ".": {
      "import": "./client/index.js",
      "types": "./client/index.d.ts"
    },
    "./runtime": {
      "import": "./runtime/index.js",
      "types": "./runtime/index.d.ts"
    }
  }
}